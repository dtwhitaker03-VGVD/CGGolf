# Copy this file to .env and fill in the values from your Supabase project's
# Settings > API page (Project URL and the "anon" / "public" key).
#
# The anon key is safe to expose in client-side code and to commit -- it's
# the public key Supabase's own docs say to embed in a browser app, and
# access is enforced by the Row Level Security policies in supabase/schema.sql,
# not by keeping this key secret. Never put the "service_role" key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
